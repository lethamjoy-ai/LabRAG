GROQ_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=lab-rag
EMBEDDING_DIMENSION=384
PINECONE_NAMESPACE_FIXED=fixed-chunks
PINECONE_NAMESPACE_SECTION=section-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_BATCH_SIZE=32
PINECONE_UPSERT_BATCH_SIZE=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
MAX_FILE_BYTES=20971520
CHUNK_SIZE=500
CHUNK_OVERLAP=75
SECTION_MAX_TOKENS=500
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
# Optional paid alternative (set these instead of the local values):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=384
# Uses OPENAI_API_KEY below, with separate model-specific Pinecone namespaces.
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai
# Optional OpenAI chat model (runtime selector; separate API billing)
OPENAI_LLM_MODEL=gpt-4.1-mini
# Shared OpenAI API credentials for explicitly selected chat or embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PINECONE_NAMESPACE=lab-reference-v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Day 4 chat settings (existing values preserved)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
RAG_DEFAULT_STRATEGY=section
RAG_MAX_HISTORY_TURNS=5
RAG_ENABLE_TRACING=false

# Optional remote tracing; disabled by default. Use only public/synthetic questions.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_CAPTURE_FULL_IO=false
LANGSMITH_PROJECT=LabRAG
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
